# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apnarooms?schema=public"

# API
API_PORT=4000
# Comma separated. Production example:
# CORS_ORIGIN="http://localhost:3000,https://apnarooms-guwahati-web.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Firebase client, used by apps/web
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin, used by apps/api
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Comma-separated backend owner emails. Matching users are promoted on login/sync.
ADMIN_EMAILS=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Public app URLs
NEXT_PUBLIC_API_BASE_URL="https://apnarooms-guwahati.onrender.com/api"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
