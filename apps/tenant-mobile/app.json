{
  "expo": {
    "name": "ApnaRooms Tenant",
    "slug": "apnarooms-tenant",
    "scheme": "apnaroomstenant",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/brand/apnarooms-icon.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/apnarooms-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B55B7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.apnarooms.tenant",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/apnarooms-icon.jpeg",
        "backgroundColor": "#5B55B7"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://darkred-coyote-647666.hostingersite.com/api",
      "router": {},
      "eas": {
        "projectId": "a3d1c154-7b19-4503-81b0-a3f652d727be"
      }
    },
    "owner": "agent22"
  }
}
