{
  "name": "@apnarooms/db",
  "private": true,
  "type": "module",
  "main": "dist/prisma.js",
  "types": "dist/prisma.d.ts",
  "exports": {
    ".": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "node scripts/prisma-push.mjs",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:promote-admin": "tsx src/scripts/promote-admin.ts",
    "prisma:seed-launch": "tsx src/scripts/seed-launch-properties.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.6.0",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
