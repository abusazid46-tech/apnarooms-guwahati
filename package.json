{
  "name": "apnarooms",
  "private": true,
  "type": "module",
  "main": "server.js",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "hostinger:build": "pnpm --filter @apnarooms/shared build && pnpm --filter @apnarooms/db build && pnpm --filter @apnarooms/api build",
    "hostinger:start": "pnpm --filter @apnarooms/api start",
    "start": "node server.js",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @apnarooms/db prisma:generate",
    "db:migrate": "pnpm --filter @apnarooms/db prisma:migrate",
    "db:push": "pnpm --filter @apnarooms/db prisma:push",
    "db:seed": "pnpm --filter @apnarooms/db prisma:seed",
    "db:promote-admin": "pnpm --filter @apnarooms/db prisma:promote-admin",
    "db:seed-launch": "pnpm --filter @apnarooms/db prisma:seed-launch"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
